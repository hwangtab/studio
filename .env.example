# Resend Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional: Override default from address (default: Studio NOL <noreply@studionol.co.kr>)
# Requires domain verification in Resend dashboard before use
# RESEND_FROM=Studio NOL <noreply@studionol.co.kr>

# Inbound webhook (hello@studionol.co.kr → Gmail 포워딩) svix 서명 시크릿
# Resend 대시보드 Webhooks 또는 POST /webhooks 생성 응답의 signing_secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Public site URL for canonical/sitemap
NEXT_PUBLIC_SITE_URL=https://studionol.co.kr

# Optional: Vercel KV — Rate limiting (자동 주입됨, 로컬 테스트 시 수동 설정)
# KV_REST_API_URL=https://xxx.kv.vercel-storage.com
# KV_REST_API_TOKEN=your_kv_token

# Optional: CORS — 허용 Origin 목록 (콤마 구분, 기본값: studionol.co.kr)
# ALLOWED_ORIGINS=https://studionol.co.kr,https://www.studionol.co.kr

# Google Search Console (GSC) Audit Cron (/api/cron/gsc-audit)
# Vercel Cron 요청 인증용 Bearer 토큰 — Vercel Dashboard > Project > Cron Jobs에서 확인
# CRON_SECRET=your_vercel_cron_secret

# GSC OAuth2 (Google Cloud Console > OAuth 2.0 credentials)
# GSC_OAUTH_CLIENT_ID=your_gsc_client_id
# GSC_OAUTH_CLIENT_SECRET=your_gsc_client_secret
# GSC_OAUTH_REFRESH_TOKEN=your_gsc_refresh_token
# GSC_SITE_URL=sc-domain:studionol.co.kr

# Vercel Blob — GSC audit 결과 스냅샷 저장
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Google PageSpeed Insights API — Core Web Vitals 모니터링용 (선택사항)
# https://console.cloud.google.com/apis/credentials 에서 생성
# PAGESPEED_API_KEY=your_pagespeed_api_key

# Google Cloud Service Account — GSC/BigQuery 접근용 (선택사항)
# 서비스 계정 JSON 키 파일의 로컬 경로
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# GA4 Data API — scripts/ga4-fetch.mjs 진단 스크립트용
# GA4_PROPERTY_ID=000000000           (GA4 Admin → Property settings에서 확인)
# GA4_OAUTH_REFRESH_TOKEN=your_token  (발급: node --env-file=.env.local scripts/ga4-oauth-setup.mjs)

# Turso Database — 전자계약 데이터 저장용
# https://turso.tech/ 에서 데이터베이스 URL과 인증 토큰 발급
# TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token
ADMIN_SESSION_SECRET=your-random-32-byte-secret

# 펀딩 개설자 세션 쿠키 서명 키. 32자 이상 무작위 문자열.
# ADMIN_SESSION_SECRET와 **다른 값**이어야 한다 — 하나가 새도 다른 하나가 열리지 않게.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREATOR_SESSION_SECRET=

# Meta 소셜 발행 (scripts/social). 앱 ID·시크릿은 Vercel env에 있다 — `vercel env pull`로 받는다.
# 액세스 토큰은 env가 아니라 Turso `social_tokens`에 산다(Vercel Cron이 주간 갱신).
# 유저 id는 scripts/social/auth.mjs가 채운다.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=

# 필드 암호화 키 — 주민등록번호 등 고유식별정보를 DB에 넣기 전 암호화한다
# (lib/crypto/fieldCrypto.ts, AES-256-GCM). base64 32바이트.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# **이 키를 잃으면 저장된 값을 복호화할 수 없다** — 개설자가 다시 입력해야 한다.
# FUNDING_FIELD_KEY=

# ── 음악연습실 시간제 예약 (lib/booking/email.ts buildPracticeRoomGuide) ─────────────
# 확정 메일에 실리는 입장 안내. **전부 비밀이라 여기엔 예시만** — 실제 값은 .env.local과
# Vercel env에만 둔다. 이 저장소는 공개다. 하나라도 비면 메일은 "별도로 보내드립니다"로
# 나가고 운영자 메일과 notificationError에 경고가 남는다(건강 점검이 매일 잡는다).
PRACTICE_ROOM_ENTRANCE_CODE=0000*
PRACTICE_ROOM_ROOM_CODE_R02=0000*
# 방을 더 열면 PRACTICE_ROOM_ROOM_CODE_<방번호> 를 추가한다(예: PRACTICE_ROOM_ROOM_CODE_R05).
PRACTICE_ROOM_WIFI_SSID=example_ssid
PRACTICE_ROOM_WIFI_PASSWORD=example_password
# 비우면 입구 비밀번호와 같은 값을 쓴다.
# PRACTICE_ROOM_RESTROOM_CODE=0000*
# 선택 — 연습실 예약을 올릴 **별도** 구글 캘린더. 녹음실 캘린더(BOOKING_GCAL_ID)와 같은 값을
# 넣으면 안 된다: 녹음 슬롯 조회가 연습실 예약을 바쁨으로 읽어 녹음을 막는다. 비우면 캘린더에
# 올리지 않고 관리자 화면·메일로만 알린다.
# PRACTICE_ROOM_GCAL_ID=xxxxxxxx@group.calendar.google.com
