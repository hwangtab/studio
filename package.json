{
  "name": "studio-nori",
  "homepage": "https://studionol.co.kr",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/functions": "^3.7.6",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "12.34.0",
    "gray-matter": "^4.0.3",
    "i18next": "25.8.4",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.427.0",
    "markdown-to-jsx": "^7.7.6",
    "next": "15.5.23",
    "next-sitemap": "4.2.3",
    "postcss": "^8.5.26",
    "prismjs": "^1.30.0",
    "puppeteer-core": "^25.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "16.5.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.8.0",
    "validator": "^13.15.26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint pages components lib data utils hooks types scripts middleware.ts next.config.mjs --ext .js,.jsx,.mjs,.cjs,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "generate:manifests": "node scripts/generate-portfolio-meta.js && node scripts/generate-story-catalog.js && node scripts/generate-story-listing.js",
    "generate:page-lastmod": "node scripts/generate-page-lastmod.mjs",
    "prebuild": "node scripts/optimizeImages.js && npm run generate:manifests && node scripts/generate-hero-font.mjs && node scripts/generate-body-font.mjs",
    "postbuild": "rm -f public/sitemap*.xml public/robots.txt && next-sitemap && node scripts/normalize-sitemap-hreflang.js",
    "test": "jest",
    "db:generate": "node --env-file=.env.local node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file=.env.local node_modules/.bin/drizzle-kit studio",
    "content-check": "node scripts/content-quality-check.js --korean",
    "content-check:ci": "node scripts/content-quality-check.js --korean --ci",
    "audit:thin": "node scripts/audit-thin-content.js --summary",
    "audit:thin:ci": "node scripts/audit-thin-content.js --fail"
  },
  "browserslist": {
    "production": [
      "chrome >= 92",
      "firefox >= 92",
      "safari >= 16",
      "edge >= 92",
      "ios_saf >= 16",
      "samsung >= 19",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@google-analytics/data": "^6.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "25.2.3",
    "@types/prismjs": "^1.26.5",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.18",
    "googleapis": "^171.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "subset-font": "^2.5.0",
    "tsx": "^4.23.1",
    "vercel": "^54.14.5"
  },
  "overrides": {
    "tar": ">=7.5.11"
  }
}
