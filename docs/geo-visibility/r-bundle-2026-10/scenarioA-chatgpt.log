       [32m'  const start = Date.now();\n'[39m +
       [32m'  while (Date.now() - start < maxWaitMs) {\n'[39m +
       [32m'    const snap = await snapshot(page, { interactive: true });\n'[39m +
       [32m'    const hasStop = /응답 중지|Stop generating|생성 중지/.test(snap.tree);\n'[39m +
       [32m'    if (!hasStop) {\n'[39m +
       [32m'      // double check by waiting a bit and re-checking stability\n'[39m +
       [32m'      await sleep(1500);\n'[39m +
       [32m'      const snap2 = await snapshot(page, { interactive: true });\n'[39m +
       [32m'      const hasStop2 = /응답 중지|Stop generating|생성 중지/.test(snap2.tree);\n'[39m +
       [32m'      if (!hasStop2) return snap2;\n'[39m +
       [32m'    }\n'[39m +
       [32m'    await sleep(1500);\n'[39m +
       [32m'  }\n'[39m +
       [32m'  return await snapshot(page, { interactive: true });\n'[39m +
       [32m'}\n'[39m +
